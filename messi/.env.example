# Messi Configuration
# Copy to .env and fill in your values

# Default position (goalkeeper, defender, midfielder, forward, winger, striker)
DEFAULT_POSITION=forward

# Default formation (4-4-2, 4-3-3, 3-5-2, 4-2-3-1, 5-3-2)
DEFAULT_FORMATION=4-3-3

# Default training level (beginner, amateur, pro)
DEFAULT_LEVEL=beginner

# Max retries for failed requests
MAX_RETRIES=3

# Request timeout in seconds
REQUEST_TIMEOUT=30
