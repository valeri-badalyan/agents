# Zhanel Configuration
# Copy to .env and fill in your values

# Default language (ru)
DEFAULT_LANGUAGE=ru

# Default tone (friendly, bold, expert)
DEFAULT_TONE=friendly

# Brand / product for quick commands
DEFAULT_BRAND=
DEFAULT_PRODUCT=

# Content plan length in weeks (1-12)
DEFAULT_WEEKS=4

# Max retries for failed requests
MAX_RETRIES=3

# Request timeout in seconds
REQUEST_TIMEOUT=30
