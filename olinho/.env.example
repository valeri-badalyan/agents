# Olinho Configuration
# Copy to .env and fill in your values

# Default output dir for built projects (relative to repo root or absolute)
DEFAULT_PROJECTS_DIR=projects

# Default browser for preview (chrome, default, edge, firefox)
DEFAULT_BROWSER=chrome

# Default project type if auto-detect fails (landing, game, app, portfolio, shop, blog)
DEFAULT_TYPE=landing

# Language for generated pages (ru)
DEFAULT_LANGUAGE=ru

# Max retries for failed operations
MAX_RETRIES=3
