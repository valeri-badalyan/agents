# Mika Configuration
# Copy to .env and fill in your values

# Default language (ru, en, hy)
DEFAULT_LANG=ru

# Default currency
DEFAULT_CURRENCY=RUB

# Support phone and hours
SUPPORT_PHONE=8-800-555-35-35
SUPPORT_HOURS=24/7

# Max retries for failed requests
MAX_RETRIES=3

# Request timeout in seconds
REQUEST_TIMEOUT=30
