# Jouli Configuration
# Copy to .env and fill in your values

# Google Translate API Key (optional - free tier works without)
# Get from: https://cloud.google.com/translate/docs/setup
GOOGLE_TRANSLATE_API_KEY=

# Default source language (empty = auto-detect)
DEFAULT_SOURCE_LANG=

# Default target language
DEFAULT_TARGET_LANG=en

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Max retries for failed requests
MAX_RETRIES=3