# Enrique Configuration
# Copy to .env and fill in your values

# Default language: ru | hy | en (auto-detect if empty)
DEFAULT_LANGUAGE=

# Path to versioned memory JSON file
MEMORY_PATH=./enrique_memory.json

# Max conversation turns kept in memory
MAX_HISTORY=200

# Max stored key facts ("main things")
MAX_FACTS=100

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
