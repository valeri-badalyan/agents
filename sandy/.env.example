# Sandy Configuration
# Copy to .env and fill in your values

# Default language (ru, en)
DEFAULT_LANG=ru

# Default setlist energy arc (rise, wave, peak, chill)
DEFAULT_ARC=rise

# Break every N minutes in rehearsal plans
REHEARSAL_BREAK_EVERY=50

# Max retries for failed requests
MAX_RETRIES=3

# Request timeout in seconds
REQUEST_TIMEOUT=30
